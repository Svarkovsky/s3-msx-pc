# test
# sdkconfig для ESP32-S3-WROOM-1-N16R8
# Retro-go fMSX: WiFi + WebUI + FATFS + I2S(PDM) + USB Host + VGA
#

# ============================================================
# БАЗОВЫЕ НАСТРОЙКИ ПРОЦЕССОРА
# ============================================================

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240
CONFIG_ESP_CACHE_SUPPORT=y

# ============================================================
# НАСТРОЙКИ FLASH ПАМЯТИ (16 МБ)
# ============================================================

CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y

# ============================================================
# ТАБЛИЦА РАЗДЕЛОВ
# ============================================================

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="../components/retro-go/targets/s3-msx-pc/partitions.csv"

# ============================================================
# НАСТРОЙКИ PSRAM (8 МБ OCTAL)
# ============================================================

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y

# XIP: переносим .text и .rodata в PSRAM
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y

# WiFi/LWIP в PSRAM где возможно
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y

# Резерв внутренней DRAM для DMA/прерываний
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=4096

# ============================================================
# НАСТРОЙКИ ФАЙЛОВОЙ СИСТЕМЫ (FATFS + WEAR LEVELLING)
# ============================================================

CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_API_ENCODING_UTF_8=y
CONFIG_WL_SECTOR_SIZE_4096=y
CONFIG_FATFS_USE_FASTSEEK=y

# Без per-file cache (экономит ~2 КБ, последовательное чтение ROM)
CONFIG_FATFS_PER_FILE_CACHE=n

# Меньше одновременно открытых файлов
CONFIG_FATFS_FS_LOCK=2           # если retro-go одновременно держит открытыми >2 файла (например, ROM + save state + скриншот), увеличьте до 4
CONFIG_FATFS_MAX_LFN=128

# ============================================================
# ЗАЩИТА ОТ КРАШЕЙ (СТЕКИ И WDT)
# ============================================================

CONFIG_ESP_MAIN_TASK_STACK_SIZE=12288
CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=1536
CONFIG_LWIP_TCPIP_TASK_STACK_SIZE=8192
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=3072

CONFIG_SPI_FLASH_YIELD_DURING_ERASE=y
CONFIG_SPI_FLASH_ERASE_YIELD_DURATION_MS=20
CONFIG_SPI_FLASH_ERASE_YIELD_TICKS=1
CONFIG_SPI_FLASH_WRITE_CHUNK_SIZE=8192

# ============================================================
# USB HOST (КЛАВИАТУРА) — КРИТИЧНО
# ============================================================

CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=64
CONFIG_USB_HOST_HW_BUFFER_BIAS_IN=y

# ============================================================
# ОСВОБОЖДАЕМ ПИНЫ 19/20 ОТ JTAG
# ============================================================

CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_USJ_ENABLE_USB_SERIAL_JTAG=n

# ============================================================
# КЭШИРОВАНИЕ — КРИТИЧНО ДЛЯ VGA
# ============================================================

CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y

# ============================================================
# ЛОГИ (МИНИМУМ)
# ============================================================

#CONFIG_LOG_DEFAULT_LEVEL_WARN=y
#CONFIG_LOG_DEFAULT_LEVEL=2
#CONFIG_LOG_MAXIMUM_LEVEL=2
#CONFIG_LOG_DYNAMIC_BUFFER=y
#CONFIG_LOG_BUFFER_SIZE=1024

# Если отладка уже не нужна, можно немного освободить ресурсов
CONFIG_LOG_DEFAULT_LEVEL_NONE=y
CONFIG_LOG_DEFAULT_LEVEL=0
CONFIG_LOG_MAXIMUM_LEVEL=0
# CONFIG_LOG_DYNAMIC_BUFFER — можно оставить или убрать
# CONFIG_LOG_BUFFER_SIZE — не используется при NONE

# ============================================================
# HTTP SERVER (WEBUI RETRO-GO)
# ============================================================

CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_STACK_SIZE=4096
CONFIG_HTTPD_MAX_URI_LEN=256

# ============================================================
# LWIP — 10 сокетов для HTTPD 
# ============================================================

CONFIG_LWIP_MAX_SOCKETS=10
CONFIG_LWIP_MAX_ACTIVE_TCP=4
CONFIG_LWIP_MAX_LISTENING_TCP=2

# TCP MSS: 1460 для скорости загрузки ROM через WebUI
CONFIG_LWIP_TCP_MSS=1460
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=5744
CONFIG_LWIP_TCP_WND_DEFAULT=5744

# IPv6 отключён (экономит ~15-20 КБ)
CONFIG_LWIP_IPV6=n

# PPP отключён
CONFIG_LWIP_PPP_SUPPORT=n
CONFIG_LWIP_PPP_PAP_SUPPORT=n
CONFIG_LWIP_PPP_CHAP_SUPPORT=n

# ============================================================
# WIFI — ОПТИМИЗИРОВАННЫЕ БУФЕРЫ, STA+AP СОХРАНЁН
# ============================================================

# Буферы RX/TX уменьшены, но стабильны
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=12
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=12
CONFIG_ESP_WIFI_TX_BA_WIN=4
CONFIG_ESP_WIFI_RX_BA_WIN=4

# AMPDU отключён (экономит ~8-12 КБ, для WebUI приемлемо) | при слабом WiFi сигнале возможны дисконнекты. Если появятся — верните в y
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n

# SoftAP поддержка СОХРАНЕНА (нужна для меню)

# ============================================================
# BLUETOOTH — ПОЛНОСТЬЮ ОТКЛЮЧЕН
# ============================================================

CONFIG_BT_ENABLED=n

# ============================================================
# OTA — ОТКЛЮЧЕН
# ============================================================

CONFIG_ESP_HTTPS_OTA=n
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=n

# ============================================================
# ESP-TLS / HTTPS — ОТКЛЮЧЕН (HTTP ONLY)
# ============================================================

CONFIG_ESP_TLS_USING_MBEDTLS=n
CONFIG_ESP_TLS_SERVER=n

# ============================================================
# MBEDTLS — МИНИМАЛЬНЫЙ (только WPA2)
# ============================================================

CONFIG_MBEDTLS_DYNAMIC_BUFFER_CONFIG=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CA_CERT=y

# ============================================================
# FREERTOS
# ============================================================

# Режим одного ядра выключен (2 ядра в работе)
CONFIG_FREERTOS_UNICORE=n

CONFIG_FREERTOS_HZ=100
CONFIG_FREERTOS_TIMER_TASK_STACK_DEPTH=1536
CONFIG_FREERTOS_TIMER_QUEUE_LENGTH=10
CONFIG_FREERTOS_TIMER_TASK_PRIORITY=1

# ============================================================
# I2S — СОХРАНЁН (PDM АУДИО)
# ============================================================

CONFIG_I2S_ENABLE=y

# ============================================================
# SIGMADELTA — СОХРАНЁН
# ============================================================

CONFIG_SIGMADELTA_ENABLE=y

# ============================================================
# ОТКЛЮЧЕНИЕ НЕИСПОЛЬЗУЕМОГО ЖЕЛЕЗА
# ============================================================

CONFIG_TWAI_ENABLE=n
CONFIG_MCPWM_ENABLE=n
CONFIG_PCNT_ENABLE=n
CONFIG_RMT_ENABLE=n
CONFIG_LEDC_ENABLE=n
CONFIG_DAC_ENABLE=n

# ADC calibration (батарея не через ADC в вашем таргете)
CONFIG_ADC_CAL_EFUSE_TP_ENABLE=n
CONFIG_ADC_CAL_EFUSE_VREF_ENABLE=n
CONFIG_ADC_CAL_LUT_ENABLE=n

# ============================================================
# ДОПОЛНИТЕЛЬНЫЕ ОПТИМИЗАЦИИ
# ============================================================

CONFIG_ESP_SYSTEM_EVENT_QUEUE_SIZE=16
CONFIG_APPTRACE_DEST_NONE=y
CONFIG_APPTRACE_ENABLE=n
CONFIG_COMPILER_CXX_EXCEPTIONS=n
CONFIG_COMPILER_CXX_RTTI=n

# ============================================================
# ДОПОЛНИТЕЛЬНЫЕ МИКРО-ОПТИМИЗАЦИИ 
# ============================================================

# Уменьшаем стек IPC-задач (экономия DRAM)
CONFIG_ESP_IPC_TASK_STACK_SIZE=1024

# Ограничиваем максимальное число открытых VFS-файлов
CONFIG_VFS_MAX_COUNT=8

# High Performance Mode для Flash (ускорение чтения)
CONFIG_SPI_FLASH_HPM_ON=y

# Убираем обратную совместимость FreeRTOS (экономия Flash)
CONFIG_FREERTOS_ENABLE_BACKWARD_COMPATIBILITY=n

# Разрешаем слияние одинаковых констант (экономия Flash)
CONFIG_COMPILER_NO_MERGE_CONSTANTS=n

# Отключаем поддержку терминальных настроек (экономия ~1.8 КБ)
CONFIG_VFS_SUPPORT_TERMIOS=n

# Экономия 25-50 КБ Flash (облегчённые printf/scanf из ROM)
CONFIG_NEWLIB_NANO_FORMAT=y

# Экономия ~2-5 КБ (убирает текстовые названия ошибок)
CONFIG_ESP_ERR_TO_NAME_LOOKUP=n

# Экономия ~1 КБ Flash + ~500 B RAM
CONFIG_LOG_DYNAMIC_LEVEL_CONTROL=n

# Экономия несколько КБ в .rodata (пути к файлам)
CONFIG_COMPILER_HIDE_PATHS_MACROS=y

# Экономия несколько КБ в .rodata (тексты ошибок в макросах)
CONFIG_COMPILER_OPTIMIZATION_CHECKS_SILENT=y

# ============================================================
# ОТКЛЮЧЕНИЕ ASSERTIONS 
# ============================================================

CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_DISABLE=y
# CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_DISABLE is not set
#CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_SILENT=y
CONFIG_HAL_DEFAULT_ASSERTION_LEVEL=0

# LTO
#CONFIG_COMPILER_OPTIMIZATION_LTO=y
#CONFIG_LTO_FAT_OBJECTS=y
